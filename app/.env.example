DATABASE_URL=postgresql://gamelog:gamelog@localhost:5433/gamelog
SESSION_SECRET=
APP_URL=http://localhost:3000
CRON_SECRET=

# Optional external API keys (leave empty to disable the integration)
STEAM_API_KEY=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
RAWG_API_KEY=
SGDB_API_KEY=

# Optional platform service accounts (leave empty to use offline fixtures)
PSN_NPSSO=
XBOX_OPENXBL_KEY=
RA_USERNAME=
RA_API_KEY=

# Optional Google login (both required; without them the Google button is hidden)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional transactional e-mail (Resend). Empty = e-mails go to the server log in development;
# in production, features that need e-mail say it is off. MAIL_FROM defaults to the value below.
RESEND_API_KEY=
MAIL_FROM="Tralked <no-reply@tralked.com>"

# Gallery image storage (Vercel Blob). Required in production: without it uploads answer 503.
# In development, empty = files go to public/uploads.
BLOB_READ_WRITE_TOKEN=

// Tralked data model. See docs/superpowers/specs/2026-10-31-gamelog-design.md (section 7)
// and docs/superpowers/specs/2026-10-31-tralked-plano-2-design.md (Plan 2 additions).
//
// String "enums" (validated in code, stored as text). Every set used below:
//   Platform        steam | psn | xbox | retro
//   User.role       admin | editor | author | user
//   TrophyTier      bronze | silver | gold | platinum            (PSN only)
//   Attribute       vigor | precisao | gloria | colecao | exploracao | constancia | sabedoria
//   GameMedia.kind  video | screenshot | artwork | cover | hero | logo
//   GameMedia.source igdb | sgdb | steam | rawg | fixture
//   Article.status  draft | review | published | archived
//   Content source  editorial | bot                            (Article.source, Guide.source)
//   Guide.status    draft | review | published
//   Comment target  article | guide | photo | thread
//   Comment.status  visible | hidden | removed
//   Report target   article | guide | photo | thread | comment | post | user
//   Report.status   open | resolved | dismissed
//   Thread.status   open | locked | hidden | removed
//   Post.status     visible | hidden | removed
//   Photo.status    visible | hidden | removed
//   ApiKey scope    articles:write | guides:write | publish | media:write
//   Ingestion kind  article | guide
//   Ingestion status created | updated | rejected
//   Notification.kind level_up | skill_up | attribute_up | comment_reply | forum_reply |
//                   thread_solved | photo_like | content_published | report_resolved | system
//
// Deleting a User (LGPD): personal data cascades; authored content (guides, tips, revisions,
// comments, forum threads/posts, photos, reports, API keys) is kept with its author set to null.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Users ----------

model User {
  id                String    @id @default(cuid())
  /// Steam account (also mirrored in LinkedAccount). Null for accounts created through Google.
  steamId           String?   @unique
  /// Google OpenID `sub` (login of readers; may be linked to an existing account).
  googleSub         String?   @unique
  email             String?
  bio               String?
  handle            String    @unique
  displayName       String
  avatarUrl         String?
  profilePublic     Boolean   @default(false)
  /// admin | editor | author | user
  role              String    @default("user")
  /// Last successful sync.
  lastSyncedAt      DateTime?
  /// Last sync attempt (success or failure); cron rotates on this so failing users cannot starve it.
  lastSyncAttemptAt DateTime?
  /// When the "Despertar" level-up sequence of the first sync was shown (it is shown once).
  despertarShownAt  DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  linkedAccounts LinkedAccount[]
  games          UserGame[]
  achievements   UserAchievement[]
  ledger         XpLedgerEntry[]
  skills         SkillProgress[]
  attributes     AttributeProgress[]
  stats          UserStats?
  missions       Mission[]
  gameOpens      GameOpen[]
  guidesWritten  Guide[]
  guideVersions  GuideVersion[]
  tips           GuideTip[]
  votes          GuideVote[]
  revisions      GuideRevision[]
  stepProgress   GuideStepProgress[]
  author         Author?
  ownedFamilies  Family[]
  membership     FamilyMember?
  comments       Comment[]
  reportsFiled   Report[]            @relation("ReportReporter")
  reportsHandled Report[]            @relation("ReportResolver")
  forumThreads   ForumThread[]
  forumPosts     ForumPost[]
  photos         Photo[]
  photoLikes     PhotoLike[]
  apiKeys        ApiKey[]
  notifications  Notification[]
}

/// A gaming account linked to a user. Ownership is proven by pasting `verifyCode` in the
/// platform profile (PSN/Xbox "about me", RA motto) before `verifyExpiresAt`; `verifiedAt` set
/// means verified. Steam accounts come from OpenID and are verified on creation.
/// A pending or unlinked (unverified) row stores `pending:<userId>[:<recent link start times,
/// base36 ms>]` as externalId, so it never reserves the platform account; the real id is written
/// on confirmation. `lastSyncAttemptAt` also holds the last confirmation attempt (cooldown).
model LinkedAccount {
  id                String    @id @default(cuid())
  userId            String
  /// steam | psn | xbox | retro
  platform          String
  /// SteamID64, PSN accountId, Xbox XUID, RA username.
  externalId        String
  /// Display name on the platform (PSN online id, gamertag, RA user).
  handle            String
  verifiedAt        DateTime?
  verifyCode        String?
  verifyExpiresAt   DateTime?
  lastSyncAttemptAt DateTime?
  lastSyncedAt      DateTime?
  createdAt         DateTime  @default(now())
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([platform, externalId])
  @@unique([userId, platform])
  @@index([platform, lastSyncAttemptAt])
}

// ---------- Catalog ----------

model Game {
  id                    String    @id @default(cuid())
  slug                  String    @unique
  name                  String
  /// Null for games without a Steam release (PSN/Xbox/retro only).
  steamAppId            Int?      @unique
  igdbId                Int?
  rawgId                Int?
  sgdbId                Int?
  /// Alternative names, used to match external news and platform titles to the game.
  aliases               String[]  @default([])
  developer             String?
  publisher             String?
  summary               String?
  releaseDate           DateTime?
  criticScore           Int?
  coverUrl              String?
  heroUrl               String?
  logoUrl               String?
  timeToBeatCompleteMin Int?
  platforms             String[]
  /// Steam achievement count (other platforms count their Achievement rows).
  achievementCount      Int
  /// Last catalog/rarity refresh attempt (success or failure); cron rotates on this.
  lastSyncAttemptAt     DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  skills        GameSkill[]
  platformLinks GamePlatformLink[]
  media         GameMedia[]
  achievements  Achievement[]
  users         UserGame[]
  opens         GameOpen[]
  guide         Guide?
  /// Legacy single-game link of articles (Article.gameId); new code uses `articleLinks`.
  articles      Article[]
  articleLinks  ArticleGame[]
  externalNews  ExternalNews[]
  forumThreads  ForumThread[]
  photos        Photo[]
}

/// The game's id on a platform (PSN npCommunicationId, Xbox titleId, RA game id, Steam appid).
/// A game may have several ids on one platform (PS4/PS5 lists, regional versions).
model GamePlatformLink {
  gameId     String
  /// steam | psn | xbox | retro
  platform   String
  externalId String
  game       Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([platform, externalId])
  @@index([gameId])
}

/// Official media of a game. `url` null = no real asset yet (the UI draws generated art).
model GameMedia {
  id        String  @id @default(cuid())
  gameId    String
  /// video | screenshot | artwork | cover | hero | logo
  kind      String
  url       String?
  /// For kind = video.
  youtubeId String?
  width     Int?
  height    Int?
  /// igdb | sgdb | steam | rawg | fixture
  source    String
  order     Int     @default(0)
  game      Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId, kind, order])
}

model GameSkill {
  gameId String
  skill  String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([gameId, skill])
}

/// An achievement / trophy of a game on one platform. `apiName` is the platform's own id
/// (Steam apiname, PSN trophyId, Xbox achievement id, RA achievement id).
model Achievement {
  id          String  @id @default(cuid())
  gameId      String
  /// steam | psn | xbox | retro
  platform    String  @default("steam")
  apiName     String
  name        String
  description String?
  iconUrl     String?
  globalPct   Float?
  hidden      Boolean @default(false)
  /// PSN only: bronze | silver | gold | platinum
  trophyTier  String?
  /// Xbox gamerscore or RetroAchievements points.
  points      Int?
  /// RetroAchievements: the achievement belongs to the hardcore set. Whether a given unlock was
  /// earned in hardcore mode is UserAchievement.hardcore.
  hardcore    Boolean @default(false)
  game        Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)

  unlocks UserAchievement[]
  notes   GuideAchievementNote[]

  @@unique([gameId, platform, apiName])
}

/// A game in a user's library on one platform (the same game may be owned on several).
model UserGame {
  userId        String
  gameId        String
  /// steam | psn | xbox | retro
  platform      String    @default("steam")
  playtimeMin   Int
  unlockedCount Int
  completedAt   DateTime?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  game          Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([userId, gameId, platform])
  @@index([gameId])
}

model UserAchievement {
  userId        String
  achievementId String
  unlockedAt    DateTime
  suspicious    Boolean     @default(false)
  /// RetroAchievements: unlocked in hardcore mode.
  hardcore      Boolean     @default(false)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@id([userId, achievementId])
  @@index([achievementId])
  @@index([userId, unlockedAt])
}

/// First time a logged-in user opened a game page (the sealed-case intro plays once).
model GameOpen {
  userId   String
  gameId   String
  openedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game     Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([userId, gameId])
}

// ---------- RPG ----------

/// Immutable XP ledger; level, skills and attributes are derived from it.
///
/// `source` / `sourceKey` conventions (sourceKey makes the entry idempotent per user):
///   achievement -> achievementId (unique across platforms: Achievement rows are per platform;
///                  `platform` says which one)
///   platinum    -> gameId for Steam, `${platform}:${gameId}` for psn | xbox | retro
///                  (a game can be completed once per platform)
///   mission     -> missionId
///   guide_vote  -> `${tipId}:${voterUserId}`
///   seed        -> 'baseline' (synthetic entry, development seed data only)
///
/// Skill points: `skillPoints` holds explicit per-skill points ({"soulslike": 123}).
/// When null, each skill in `skills` receives skillPointsFor(xp, skills.length).
///
/// Entries are never deleted or edited: confirmed fraud sets `voidedAt`, and voided entries
/// are left out of every derived value. Unlinking a PSN/Xbox/RA account also voids that
/// platform's entries (relinking the same account does not pay them again).
model XpLedgerEntry {
  id          String    @id @default(cuid())
  userId      String
  source      String
  sourceKey   String
  xp          Int
  skills      String[]
  skillPoints Json?
  /// steam | psn | xbox | retro; null for entries not tied to a platform (missions, votes, seed).
  platform    String?
  voidedAt    DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source, sourceKey])
  @@index([userId, createdAt])
}

model SkillProgress {
  userId String
  skill  String
  level  Int
  points Int
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, skill])
  @@index([skill, level, points])
}

/// Character attributes: vigor | precisao | gloria | colecao | exploracao | constancia | sabedoria
model AttributeProgress {
  userId    String
  attribute String
  level     Int
  points    Int
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, attribute])
  @@index([attribute, level, points])
}

model UserStats {
  userId        String @id
  totalXp       Int
  level         Int
  vocation      String
  streakCurrent Int    @default(0)
  streakBest    Int    @default(0)
  shields       Int    @default(0)
  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([totalXp])
  @@index([level])
}

model Mission {
  id          String    @id @default(cuid())
  userId      String
  /// daily | weekly
  kind        String
  periodKey   String
  title       String
  condition   Json
  rewardXp    Int
  progress    Int       @default(0)
  completedAt DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, periodKey, title])
}

// ---------- Guides ----------

model Guide {
  id           String    @id @default(cuid())
  gameId       String    @unique
  authorId     String?
  /// draft | review | published
  status       String
  version      String
  difficulty   Int
  hoursMin     Int
  hoursMax     Int
  playthroughs String
  missables    Int
  online       Int
  overview     String[]
  warnings     String[]
  /// [{ name, total, description }]
  collectibles Json      @default("[]")
  /// Optional free-form body as ContentBlock[] (same schema as Article.blocks).
  blocks       Json?
  /// [{ title, url }] references the guide was written from (bot API).
  sources      Json      @default("[]")
  /// editorial | bot
  source       String?
  /// API key that created the guide (source = bot).
  botKeyId     String?
  usefulCount  Int       @default(0)
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  game         Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  author       User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  botKey       ApiKey?   @relation(fields: [botKeyId], references: [id], onDelete: SetNull)

  steps     GuideStep[]
  notes     GuideAchievementNote[]
  tips      GuideTip[]
  revisions GuideRevision[]
  versions  GuideVersion[]
}

/// Full snapshot of a guide (fields, steps, notes) saved on every edit, for diff and restore.
model GuideVersion {
  id        String   @id @default(cuid())
  guideId   String
  /// Sequential per guide, starting at 1.
  version   Int
  snapshot  Json
  authorId  String?
  createdAt DateTime @default(now())
  guide     Guide    @relation(fields: [guideId], references: [id], onDelete: Cascade)
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([guideId, version])
}

model GuideStep {
  id                  String   @id @default(cuid())
  guideId             String
  order               Int
  title               String
  hours               String
  /// Plain text (always set; for bot steps it is the text of `blocks` without markup).
  body                String
  /// Rich body as ContentBlock[] (bot API). Null for steps written as plain text.
  blocks              Json?
  achievementApiNames String[]
  guide               Guide    @relation(fields: [guideId], references: [id], onDelete: Cascade)

  progress GuideStepProgress[]

  @@unique([guideId, order])
}

model GuideAchievementNote {
  id            String      @id @default(cuid())
  guideId       String
  achievementId String
  /// historia | chefes | coletaveis | desafio | dlc
  category      String
  spoiler       Boolean     @default(false)
  /// Plain text (always set; for bot notes it is the text of `tipBlocks` without markup).
  tip           String
  /// Rich tip as ContentBlock[] (bot API). Null for tips written as plain text.
  tipBlocks     Json?
  steps         String[]
  guide         Guide       @relation(fields: [guideId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([guideId, achievementId])
}

model GuideTip {
  id        String   @id @default(cuid())
  guideId   String
  authorId  String?
  body      String
  votes     Int      @default(0)
  createdAt DateTime @default(now())
  guide     Guide    @relation(fields: [guideId], references: [id], onDelete: Cascade)
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  voters GuideVote[]

  @@index([guideId])
}

model GuideVote {
  userId String
  tipId  String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tip    GuideTip @relation(fields: [tipId], references: [id], onDelete: Cascade)

  @@id([userId, tipId])
  @@index([tipId])
}

model GuideRevision {
  id        String   @id @default(cuid())
  guideId   String
  version   String
  summary   String
  authorId  String?
  createdAt DateTime @default(now())
  guide     Guide    @relation(fields: [guideId], references: [id], onDelete: Cascade)
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([guideId])
}

model GuideStepProgress {
  userId String
  stepId String
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  step   GuideStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@id([userId, stepId])
}

// ---------- Editorial ----------

model Author {
  id     String  @id @default(cuid())
  handle String  @unique
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  articles Article[]
}

model Article {
  id            String        @id @default(cuid())
  slug          String        @unique
  title         String
  subtitle      String?
  /// Short summary for cards and metadata.
  excerpt       String?
  /// Legacy Markdown body (Plan 1 pages). New code renders `blocks`.
  body          String
  /// ContentBlock[] (spec "Formato de conteúdo único em blocos").
  blocks        Json          @default("[]")
  /// draft | review | published | archived
  status        String        @default("draft")
  /// GAMES | GUIAS | COMUNIDADE
  category      String
  platforms     String[]
  imageLabel    String
  authorId      String
  /// Legacy single game (Plan 1 pages); new code uses `games` (ArticleGame).
  gameId        String?
  /// editorial | bot
  source        String?
  /// API key that created the article (source = bot).
  botKeyId      String?
  /// 0 = list, 1 = side highlight, 2 = main highlight
  featured      Int           @default(0)
  likes         Int           @default(0)
  comments      Int           @default(0)
  humanAuthored Boolean       @default(true)
  /// When an editor approved the article. For bot articles (source = bot) this turns on the
  /// "Gerado por robô · revisado pela redação" badge; bots publishing with the `publish` scope
  /// leave it null ("Gerado por robô").
  reviewedAt    DateTime?
  /// Publication time. For drafts it holds the creation time until the article is published.
  publishedAt   DateTime      @default(now())
  /// Publish automatically at this time (status moves to published).
  scheduledAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  author        Author        @relation(fields: [authorId], references: [id])
  game          Game?         @relation(fields: [gameId], references: [id])
  botKey        ApiKey?       @relation(fields: [botKeyId], references: [id], onDelete: SetNull)
  games         ArticleGame[]

  @@index([publishedAt])
  @@index([status, publishedAt])
}

/// Games an article is about (n:n).
model ArticleGame {
  articleId String
  gameId    String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  game      Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([articleId, gameId])
  @@index([gameId])
}

/// Headline from an external RSS feed: only title, link, source and date are stored.
model ExternalNews {
  id          String   @id @default(cuid())
  gameId      String?
  title       String
  url         String   @unique
  /// Name of the publication (NewsFeed.name).
  source      String
  publishedAt DateTime
  fetchedAt   DateTime @default(now())
  game        Game?    @relation(fields: [gameId], references: [id], onDelete: SetNull)

  @@index([gameId, publishedAt])
  @@index([publishedAt])
}

/// RSS feed configured in the admin.
model NewsFeed {
  id     String  @id @default(cuid())
  name   String
  url    String  @unique
  active Boolean @default(true)
}

// ---------- Community ----------

/// Comment on an article, guide, photo or forum thread (polymorphic target, no FK).
model Comment {
  id         String    @id @default(cuid())
  authorId   String?
  /// article | guide | photo | thread
  targetType String
  targetId   String
  body       String
  /// visible | hidden | removed
  status     String    @default("visible")
  createdAt  DateTime  @default(now())
  editedAt   DateTime?
  author     User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId, createdAt])
  @@index([authorId, createdAt])
}

model Report {
  id           String    @id @default(cuid())
  reporterId   String?
  /// article | guide | photo | thread | comment | post | user
  targetType   String
  targetId     String
  reason       String
  /// open | resolved | dismissed
  status       String    @default("open")
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedById String?
  reporter     User?     @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  resolvedBy   User?     @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([targetType, targetId])
}

model ForumCategory {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String
  order       Int    @default(0)

  threads ForumThread[]
}

/// Forum topic: in a general category, or a game's own topic list (gameId), or both.
model ForumThread {
  id           String         @id @default(cuid())
  categoryId   String?
  gameId       String?
  authorId     String?
  title        String
  /// URL slug (not unique; routes use id + slug).
  slug         String
  /// open | locked | hidden | removed
  status       String         @default("open")
  pinned       Boolean        @default(false)
  /// Reply marked "Resolveu" by the thread author.
  solvedPostId String?        @unique
  createdAt    DateTime       @default(now())
  lastPostAt   DateTime       @default(now())
  category     ForumCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  game         Game?          @relation(fields: [gameId], references: [id], onDelete: SetNull)
  author       User?          @relation(fields: [authorId], references: [id], onDelete: SetNull)
  solvedPost   ForumPost?     @relation("SolvedPost", fields: [solvedPostId], references: [id], onDelete: SetNull)

  posts ForumPost[]

  @@index([categoryId, pinned, lastPostAt])
  @@index([gameId, lastPostAt])
}

model ForumPost {
  id        String       @id @default(cuid())
  threadId  String
  authorId  String?
  body      String
  createdAt DateTime     @default(now())
  editedAt  DateTime?
  /// visible | hidden | removed
  status    String       @default("visible")
  thread    ForumThread  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author    User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  solves    ForumThread? @relation("SolvedPost")

  @@index([threadId, createdAt])
  @@index([authorId, createdAt])
}

/// Community gallery photo. `url` null = example data (the UI draws generated art).
model Photo {
  id        String   @id @default(cuid())
  authorId  String?
  gameId    String?
  url       String?
  width     Int
  height    Int
  caption   String?
  /// visible | hidden | removed
  status    String   @default("visible")
  createdAt DateTime @default(now())
  likeCount Int      @default(0)
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  game      Game?    @relation(fields: [gameId], references: [id], onDelete: SetNull)

  likes PhotoLike[]

  @@index([status, createdAt])
  @@index([authorId, createdAt])
  @@index([gameId, createdAt])
}

model PhotoLike {
  userId    String
  photoId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  photo     Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@id([userId, photoId])
  @@index([photoId])
}

// ---------- Bot API ----------

/// Bot API key (`Bearer tk_live_…`). Only the SHA-256 `hash` is stored; the key is shown once.
model ApiKey {
  id          String    @id @default(cuid())
  name        String
  /// First characters of the key, shown in the admin to tell keys apart.
  prefix      String
  hash        String    @unique
  /// articles:write | guides:write | publish | media:write
  scopes      String[]
  createdById String?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  articles   Article[]
  guides     Guide[]
  ingestions IngestionLog[]
}

/// One bot POST. (keyId, idempotencyKey) is unique, so a repeated request returns the stored result.
model IngestionLog {
  id             String   @id @default(cuid())
  keyId          String
  idempotencyKey String
  /// article | guide
  kind           String
  /// created | updated | rejected
  status         String
  /// Article or Guide id (created | updated).
  resultId       String?
  /// Validation errors (rejected), by JSON Pointer path.
  error          Json?
  /// SHA-256 of method + path + canonical JSON body. Same key and hash replays `response`;
  /// same key with another hash is a 409.
  requestHash    String?
  /// The HTTP answer given to the request: { status, body }. Replayed on a repeat.
  response       Json?
  createdAt      DateTime @default(now())
  key            ApiKey   @relation(fields: [keyId], references: [id], onDelete: Cascade)

  @@unique([keyId, idempotencyKey])
  @@index([createdAt])
}

// ---------- Notifications ----------

model Notification {
  id        String    @id @default(cuid())
  userId    String
  /// level_up | skill_up | attribute_up | comment_reply | forum_reply | thread_solved |
  /// photo_like | content_published | report_resolved | system
  kind      String
  title     String
  body      String?
  /// Relative link inside the site.
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

// ---------- Family ----------

model Family {
  id        String   @id @default(cuid())
  name      String
  ownerId   String?
  createdAt DateTime @default(now())
  owner     User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  members FamilyMember[]
  invites FamilyInvite[]
}

model FamilyMember {
  familyId String
  userId   String   @unique
  role     String
  joinedAt DateTime @default(now())
  family   Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([familyId, userId])
}

model FamilyInvite {
  id        String    @id @default(cuid())
  familyId  String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  family    Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
}

model NewsletterSubscriber {
  id          String    @id @default(cuid())
  email       String    @unique
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())
}

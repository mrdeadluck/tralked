// Tralked data model. See docs/superpowers/specs/2026-10-31-gamelog-design.md (section 7)
// and docs/superpowers/specs/2026-10-31-tralked-plano-2-design.md (Plan 2 additions).
//
// String "enums" (validated in code, stored as text). Every set used below:
//   Platform        steam | psn | xbox | retro
//   User.role       admin | editor | author | user
//   TrophyTier      bronze | silver | gold | platinum            (PSN only)
//   Attribute       vigor | precisao | gloria | colecao | exploracao | constancia | sabedoria |
//                   resistencia | acervo
//   GameMedia.kind  video | screenshot | artwork | cover | hero | logo
//   GameMedia.source igdb | sgdb | steam | rawg | fixture
//   Article.status  draft | review | published | archived
//   Content source  editorial | bot                            (Article.source, Guide.source)
//   Guide.status    draft | review | published
//   Comment target  article | guide | photo | thread
//   Comment.status  visible | hidden | removed | deleted (by its author: body cleared, placeholder kept)
//   Report target   article | guide | photo | thread | comment | post | user
//   Report.status   open | resolved | dismissed
//   Thread.status   open | locked | hidden | removed
//   Post.status     visible | hidden | removed
//   Photo.status    visible | hidden | removed
//   ApiKey scope    articles:write | guides:write | publish | media:write
//   Ingestion kind  article | guide
//   Ingestion status created | updated | rejected
//   Notification.kind level_up | skill_up | attribute_up | comment_reply | forum_reply |
//                   thread_solved | photo_like | content_published | report_resolved | system
//
// Deleting a User (LGPD): personal data cascades; authored content (guides, tips, revisions,
// comments, forum threads/posts, photos, reports, API keys) is kept with its author set to null.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Users ----------

model User {
  id                String    @id @default(cuid())
  /// Steam account, set when the Steam connection is verified (code in the profile summary) and
  /// mirrored in LinkedAccount; the Steam sync reads it. Null until Steam is connected.
  steamId           String?   @unique
  /// Google OpenID `sub` (optional login; may be linked to an existing account).
  googleSub         String?   @unique
  /// Login e-mail, stored trimmed and lowercased. Unique when present (NULLs never collide).
  email             String?   @unique
  /// When the current `email` was confirmed (link sent by e-mail, or verified by Google). Reset to
  /// null when the e-mail changes. Never blocks anything: it only shows the "e-mail confirmado" badge.
  emailVerifiedAt   DateTime?
  /// Tralked password: `scrypt$N$r$p$salt$hash` (lib/auth/password.ts). Null for accounts that
  /// never set one (Google-only accounts, and legacy accounts created by the old Steam login).
  passwordHash      String?
  bio               String?
  handle            String    @unique
  displayName       String
  avatarUrl         String?
  profilePublic     Boolean   @default(false)
  /// admin | editor | author | user
  role              String    @default("user")
  /// Last successful sync.
  lastSyncedAt      DateTime?
  /// Last sync attempt (success or failure); cron rotates on this so failing users cannot starve it.
  lastSyncAttemptAt DateTime?
  /// When the "Despertar" level-up sequence of the first sync was shown (it is shown once).
  despertarShownAt  DateTime?
  /// "Não mostrar a animação nos próximos jogos": the sealed-case intro of game pages is skipped on
  /// every device (re-enabled in /conta). The browser also remembers it for logged-out visits.
  caseIntroOff      Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  linkedAccounts LinkedAccount[]
  games          UserGame[]
  achievements   UserAchievement[]
  ledger         XpLedgerEntry[]
  skills         SkillProgress[]
  attributes     AttributeProgress[]
  stats          UserStats?
  rankStats      UserRankStats[]
  rankSnapshots  RankSnapshot[]
  missions       Mission[]
  gameOpens      GameOpen[]
  guidesWritten  Guide[]
  guideVersions  GuideVersion[]
  tips           GuideTip[]
  votes          GuideVote[]
  revisions      GuideRevision[]
  stepProgress   GuideStepProgress[]
  author         Author?
  ownedFamilies  Family[]
  membership     FamilyMember?
  comments       Comment[]
  reportsFiled   Report[]            @relation("ReportReporter")
  reportsHandled Report[]            @relation("ReportResolver")
  forumThreads   ForumThread[]
  forumPosts     ForumPost[]
  photos         Photo[]
  photoLikes     PhotoLike[]
  apiKeys        ApiKey[]
  notifications  Notification[]
  passwordResets PasswordResetToken[]
  wishlist       WishlistItem[]
}

/// A "set a new password" link (forgot password, or `pnpm user:invite`). Only the SHA-256 of the
/// random token is stored; the token is single-use (`usedAt`) and expires after an hour.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A gaming account linked to a user (Exophase model, lib/accounts/connect.ts). Typing the profile
/// in /conta/conexoes links it at once: `linkedAt` set means an active connection, which syncs and
/// pays XP. `verifiedAt` set means ownership was also proven, by pasting `verifyCode` in the
/// platform profile (Steam "Resumo", PSN/Xbox "about me", RA motto) before `verifyExpiresAt`:
/// claims of an account already on another profile need that (lib/accounts/link.ts), and an
/// active connection can prove it any time with "Verificar agora" (lib/accounts/verify.ts; the
/// code then sits on the active row). Steam rows of accounts created by the old Steam login
/// (OpenID) were verified on creation.
/// An inactive row (unlinked account, or a claim waiting for its code) stores `pending:<userId>
/// [:<recent claim start times, base36 ms>]` as externalId and has no `linkedAt`, so it never
/// reserves the platform account (database checks keep `linkedAt` and the placeholder in step).
/// `lastSyncAttemptAt` also holds the last claim confirmation attempt (cooldown).
model LinkedAccount {
  id                String    @id @default(cuid())
  userId            String
  /// steam | psn | xbox | retro
  platform          String
  /// SteamID64, PSN accountId, Xbox XUID, RA ULID (or the `pending:` placeholder of an inactive row).
  externalId        String
  /// Display name on the platform (PSN online id, gamertag, RA user).
  handle            String
  /// Active connection since (null: inactive row). Rows created with a real id are active.
  linkedAt          DateTime? @default(now())
  verifiedAt        DateTime?
  verifyCode        String?
  verifyExpiresAt   DateTime?
  /// Active connection proving ownership ("Verificar agora", lib/accounts/verify.ts): last time
  /// the platform profile was read for the code (cooldown between checks).
  verifyCheckedAt   DateTime?
  /// Why that last check failed (code_missing | not_found | different | private | error); null
  /// after a success, a new code or no check yet.
  verifyFailure     String?
  lastSyncAttemptAt DateTime?
  lastSyncedAt      DateTime?
  /// Xbox: titles whose minutes played were asked, `{ titleId: last play then (ms) }`, so titles
  /// without minutes are not asked every sync (lib/sync/platform-user.ts). Cleared on unlink.
  minutesChecked    Json?
  createdAt         DateTime  @default(now())
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([platform, externalId])
  @@unique([userId, platform])
  @@index([platform, lastSyncAttemptAt])
}

// ---------- Catalog ----------

model Game {
  id                    String    @id @default(cuid())
  slug                  String    @unique
  name                  String
  /// Null for games without a Steam release (PSN/Xbox/retro only).
  steamAppId            Int?      @unique
  igdbId                Int?
  rawgId                Int?
  sgdbId                Int?
  /// Alternative names, used to match external news and platform titles to the game.
  aliases               String[]  @default([])
  developer             String?
  publisher             String?
  summary               String?
  releaseDate           DateTime?
  criticScore           Int?
  coverUrl              String?
  heroUrl               String?
  logoUrl               String?
  timeToBeatCompleteMin Int?
  /// IGDB time to beat, rushed and main story (minutes); the 100% one is timeToBeatCompleteMin.
  timeToBeatHastyMin    Int?
  timeToBeatNormalMin   Int?
  /// Last read of the IGDB times to beat (igdb-catalog job), with or without an answer.
  timeToBeatCheckedAt   DateTime?
  /// Steam user reviews (all languages): positive and total, read by the catalog-enrich worker.
  steamReviewPositive   Int?
  steamReviewTotal      Int?
  steamReviewsAt        DateTime?
  /// Last IGDB/SteamGridDB media attempt, with or without results: games IGDB knows nothing of
  /// are not asked again for a while (lib/sync/media.ts).
  mediaCheckedAt        DateTime?
  platforms             String[]
  /// Steam achievement count (other platforms count their Achievement rows).
  achievementCount      Int
  /// Last catalog/rarity refresh attempt (success or failure); cron rotates on this.
  lastSyncAttemptAt     DateTime?
  /// Name-only entry of the full Steam catalog (lib/sync/steam-catalog.ts): it has a page but stays
  /// out of listings, the sitemap and pickers until its store details are fetched (then false).
  stub                  Boolean   @default(false)
  /// When the Steam store details (and art, achievement schema) were last written.
  detailsSyncedAt       DateTime?
  /// Someone needs this game's details (a player opened its page): the details job takes it first.
  detailsRequestedAt    DateTime?
  /// Popularity rank for the details job (SteamSpy owners lower bound); 0 = unknown.
  popularity            Int       @default(0)
  /// Name folded for search (lower case, no accents, punctuation as spaces): written by a database
  /// trigger on every insert/rename (migrations 20261102100000_game_name_search and
  /// 20261102110000_game_search_fold_v2), never by the app.
  /// /jogos and the libraries search it with a trigram index (lib/search/normalize.ts).
  searchName            String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  skills        GameSkill[]
  platformLinks GamePlatformLink[]
  media         GameMedia[]
  achievements  Achievement[]
  users         UserGame[]
  opens         GameOpen[]
  guide         Guide?
  /// Legacy single-game link of articles (Article.gameId); new code uses `articleLinks`.
  articles      Article[]
  articleLinks  ArticleGame[]
  externalNews  ExternalNews[]
  forumThreads  ForumThread[]
  photos        Photo[]
  wishlistedBy  WishlistItem[]
  releases      GameRelease[]

  /// Calendar (/calendario): catalog releases of a month.
  @@index([releaseDate])
  /// IGDB matching (releases and the console catalog import, lib/sync/igdb-games.ts). That
  /// matching also uses the expression index "Game_name_lower_idx" on lower(name) (migration
  /// 20261102090000_releases_calendar), which Prisma cannot declare; the IGDB details queue has
  /// the partial index "Game_igdb_details_queue_idx" (20261102120000_releases_catalog_indexes).
  @@index([igdbId])
  /// Name search of /jogos (stubs included): `searchName LIKE '%q%'` uses the trigram index.
  @@index([searchName(ops: raw("gin_trgm_ops"))], type: Gin)
  /// Catalog listing ("Popular" and "Nome" orders, stubs left out).
  @@index([stub, popularity(sort: Desc), name])
  @@index([stub, name])
  // The details job's queue has a partial index written in SQL (migration
  // 20261101130000_full_sync_playtime): ("lastSyncAttemptAt", popularity DESC) WHERE
  // "detailsSyncedAt" IS NULL AND "steamAppId" IS NOT NULL. Prisma cannot declare it here.
}

/// The game's id on a platform (PSN npCommunicationId, Xbox titleId, RA game id, Steam appid).
/// A game may have several ids on one platform (PS4/PS5 lists, regional versions).
model GamePlatformLink {
  gameId     String
  /// steam | psn | xbox | retro
  platform   String
  externalId String
  game       Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([platform, externalId])
  @@index([gameId])
}

/// Official media of a game. `url` null = no real asset yet (the UI draws generated art).
model GameMedia {
  id        String  @id @default(cuid())
  gameId    String
  /// video | screenshot | artwork | cover | hero | logo
  kind      String
  url       String?
  /// For kind = video.
  youtubeId String?
  width     Int?
  height    Int?
  /// igdb | sgdb | steam | rawg | fixture
  source    String
  order     Int     @default(0)
  game      Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId, kind, order])
}

model GameSkill {
  gameId String
  skill  String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([gameId, skill])
}

/// An achievement / trophy of a game on one platform. `apiName` is the platform's own id
/// (Steam apiname, PSN trophyId, Xbox achievement id, RA achievement id).
model Achievement {
  id          String  @id @default(cuid())
  gameId      String
  /// steam | psn | xbox | retro
  platform    String  @default("steam")
  apiName     String
  name        String
  description String?
  iconUrl     String?
  globalPct   Float?
  hidden      Boolean @default(false)
  /// PSN only: bronze | silver | gold | platinum
  trophyTier  String?
  /// Xbox gamerscore or RetroAchievements points.
  points      Int?
  /// RetroAchievements: the achievement belongs to the hardcore set. Whether a given unlock was
  /// earned in hardcore mode is UserAchievement.hardcore.
  hardcore    Boolean @default(false)
  game        Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)

  unlocks UserAchievement[]
  notes   GuideAchievementNote[]

  @@unique([gameId, platform, apiName])
}

/// A game in a user's library on one platform (the same game may be owned on several). Rows with
/// `playtimeMin` 0 and no unlocks are owned but never played (Steam lists them).
model UserGame {
  userId             String
  gameId             String
  /// steam | psn | xbox | retro
  platform           String    @default("steam")
  /// Playtime the platform reports (minutes). 0 when never played or not reported.
  playtimeMin        Int
  unlockedCount      Int
  completedAt        DateTime?
  /// Steam `playtime_2weeks` (minutes); null when the platform does not say.
  playtime2WeeksMin  Int?
  /// Last time played, when the platform says (Steam rtime_last_played, PSN, Xbox).
  lastPlayedAt       DateTime?
  /// When `playtimeMin` was last written from the platform (null: rows older than Plano 4).
  playtimeUpdatedAt  DateTime?
  /// Steam: `playtimeMin` at the last successful read of the player's achievements of this game,
  /// so a re-sync only reads games played since (null: never read).
  checkedPlaytimeMin Int?
  /// `playtimeMin` whose hours milestones were all offered to the ledger (lib/sync/playtime.ts);
  /// a game held back by the per-user caps keeps the old value and is offered again later.
  playtimePaidMin    Int?
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  game               Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([userId, gameId, platform])
  @@index([gameId])
}

/// A game on a user's platform wishlist (Steam IWishlistService). Replaced on every sync.
model WishlistItem {
  userId   String
  gameId   String
  /// steam
  platform String    @default("steam")
  /// The user's order on the platform (0 = top); null when not set.
  priority Int?
  addedAt  DateTime?
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  game     Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([userId, gameId, platform])
  @@index([gameId])
}

/// A game's release on one platform family (Plano 4, F10): the home "Lançamentos" card,
/// /lancamentos and the calendar. Written by the `releases` cron (lib/sync/releases.ts) from the
/// Steam store's popular new / upcoming lists (PC) and IGDB release dates (consoles and PC). One row
/// per game and family, so a release both sources list is shown once; Steam wins for PC.
model GameRelease {
  gameId    String
  /// PC | PLAYSTATION | XBOX | NINTENDO
  platform  String
  /// Release day (UTC midnight of the source's calendar date); null while not set to a day.
  date      DateTime?
  /// The source's own text when the date is not a day ("4º trimestre de 2026", "Q1 2027").
  dateLabel String?
  /// steam | igdb
  source    String
  /// Popularity in the source (Steam list position, IGDB hypes + ratings); higher first.
  score     Int       @default(0)
  /// Wide store capsule (Steam CDN), shown until the game has a cover.
  imageUrl  String?
  /// Last time a source listed it: undated releases not seen for two weeks leave "Próximos".
  seenAt    DateTime
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  game      Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([gameId, platform])
  @@index([date])
  @@index([platform, date])
}

/// Resumable position of a long-running import (e.g. `steam-applist`: the Steam app list cursor).
model SyncCursor {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model UserAchievement {
  userId          String
  achievementId   String
  unlockedAt      DateTime
  suspicious      Boolean     @default(false)
  /// RetroAchievements: unlocked in hardcore mode.
  hardcore        Boolean     @default(false)
  /// Admin decision on a suspicious unlock: null (pending) | confirmed (fraud, XP voided) |
  /// cleared (released: paid, and the anti-fraud rules no longer flag it on later syncs).
  fraudReview     String?
  fraudReviewedAt DateTime?
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement     Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@id([userId, achievementId])
  @@index([achievementId])
  @@index([userId, unlockedAt])
  @@index([suspicious, fraudReview])
}

/// First time a logged-in user opened a game page (the sealed-case intro plays once).
model GameOpen {
  userId   String
  gameId   String
  openedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game     Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([userId, gameId])
}

// ---------- RPG ----------

/// Immutable XP ledger; level, skills and attributes are derived from it.
///
/// `source` / `sourceKey` conventions (sourceKey makes the entry idempotent per user):
///   achievement    -> achievementId (unique across platforms: Achievement rows are per platform)
///   platinum       -> gameId for Steam, `${platform}:${gameId}` for psn | xbox | retro
///                     (a game can be completed once per platform)
///   mission        -> missionId (reward of a completed daily/weekly mission)
///   guide_vote     -> `${tipId}:${voterUserId}` (Sábio XP for the author of a voted tip)
///   photo_approved -> photoId (gallery upload XP, daily-limited; voided when moderation removes it)
///   forum_solved   -> forumPostId (answer marked "Resolveu"; voided when the answer is removed)
///   playtime       -> `${platform}:${gameId}:${hours}` (hours milestone of real platform playtime,
///                     5 h and up, within per-user caps, dated at payment: lib/engine/playtime.ts,
///                     lib/sync/playtime.ts; platform steam | psn | xbox | retro)
///   seed           -> 'baseline' (synthetic entry, development seed data only)
/// Fraud release (admin "Liberar") writes `achievement` / `platinum` entries exactly as the syncs
/// do, and restores entries voided earlier instead of creating new ones.
///
/// `platform`: psn | xbox | retro on entries written by those syncs (and their fraud release);
/// NULL for Steam entries (Plan 1 convention, kept: Steam sync, seed and Steam fraud release write
/// NULL, and readers treat NULL achievement/platinum entries as Steam; Steam `playtime` entries are
/// NULL too and carry `steam:` in their sourceKey) and for entries not tied to a platform (mission,
/// guide_vote, photo_approved, forum_solved, seed).
///
/// Skill points: `skillPoints` holds explicit per-skill points ({"soulslike": 123}): seed,
/// photo_approved and forum_solved set them. When null, each skill in `skills` receives
/// skillPointsFor(xp, skills.length); achievement/platinum entries take their game's current skills.
///
/// Entries are never deleted or edited: confirmed fraud and moderation removals set `voidedAt`,
/// and voided entries are left out of every derived value. Unlinking a PSN/Xbox/RA account also
/// voids that platform's entries and the mission rewards they completed (relinking the same
/// account does not pay them again).
model XpLedgerEntry {
  id          String    @id @default(cuid())
  userId      String
  source      String
  sourceKey   String
  xp          Int
  skills      String[]
  skillPoints Json?
  /// psn | xbox | retro; NULL for Steam entries and for entries not tied to a platform (see above).
  platform    String?
  voidedAt    DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source, sourceKey])
  @@index([userId, createdAt])
}

model SkillProgress {
  userId String
  skill  String
  level  Int
  points Int
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, skill])
  @@index([skill, level, points])
}

/// Character attributes: vigor | precisao | gloria | colecao | exploracao | constancia | sabedoria |
/// resistencia | acervo
model AttributeProgress {
  userId    String
  attribute String
  level     Int
  points    Int
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, attribute])
  @@index([attribute, level, points])
}

model UserStats {
  userId        String @id
  totalXp       Int
  level         Int
  vocation      String
  streakCurrent Int    @default(0)
  streakBest    Int    @default(0)
  shields       Int    @default(0)
  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([totalXp])
  @@index([level])
}

/// Highscores (Plano 4, F6): the totals behind each ranking, one row per user and scope
/// (`all` = every platform merged, or one of steam | psn | xbox | retro). Rewritten by every
/// recompute (lib/highscores/stats.ts) from the library and the valid unlocks, so a ranking is an
/// indexed read instead of an aggregate over the ledger or the unlocks.
model UserRankStats {
  userId                String
  scope                 String
  /// Playtime the platforms report, in minutes.
  playtimeMin           Int      @default(0)
  /// Valid (non-suspicious) unlocks.
  achievements          Int      @default(0)
  /// Valid unlocks at most 20% global rarity (rara, épica, lendária).
  rareAchievements      Int      @default(0)
  /// Valid unlocks at most 3% global rarity (lendária).
  legendaryAchievements Int      @default(0)
  /// Valid 100% completions (distinct games for `all`).
  perfectGames          Int      @default(0)
  gamesOwned            Int      @default(0)
  /// Games with playtime or a valid unlock.
  gamesPlayed           Int      @default(0)
  /// Acervo points (engine/attributes `acervoPoints`: 10 per played game, 5 per never played).
  acervo                Int      @default(0)
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, scope])
  @@index([scope, playtimeMin])
  @@index([scope, achievements])
  @@index([scope, rareAchievements, legendaryAchievements])
  @@index([scope, perfectGames])
  @@index([scope, acervo])
}

/// Highscores (Plano 4, F6): each board's ranking (top positions) as of the first snapshot of a
/// day (America/Sao_Paulo, `day` = YYYY-MM-DD), taken by the daily `highscores` cron. The rank
/// arrows compare today's rank with the latest earlier snapshot. Pruned after 14 days.
model RankSnapshot {
  /// Board key (lib/highscores/boards.ts `boardKey`), e.g. `nivel`, `horas:all`, `genero:rpg`.
  board     String
  day       String
  userId    String
  rank      Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([board, day, userId])
  @@index([day])
  @@index([userId])
}

model Mission {
  id          String    @id @default(cuid())
  userId      String
  /// daily | weekly
  kind        String
  periodKey   String
  title       String
  condition   Json
  rewardXp    Int
  progress    Int       @default(0)
  completedAt DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, periodKey, title])
}

// ---------- Guides ----------

model Guide {
  id           String    @id @default(cuid())
  gameId       String    @unique
  authorId     String?
  /// draft | review | published
  status       String
  version      String
  difficulty   Int
  hoursMin     Int
  hoursMax     Int
  playthroughs String
  missables    Int
  online       Int
  overview     String[]
  warnings     String[]
  /// [{ name, total, description }]
  collectibles Json      @default("[]")
  /// Optional free-form body as ContentBlock[] (same schema as Article.blocks).
  blocks       Json?
  /// [{ title, url }] references the guide was written from (bot API).
  sources      Json      @default("[]")
  /// editorial | bot
  source       String?
  /// API key that created the guide (source = bot).
  botKeyId     String?
  usefulCount  Int       @default(0)
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  game         Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  author       User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  botKey       ApiKey?   @relation(fields: [botKeyId], references: [id], onDelete: SetNull)

  steps     GuideStep[]
  notes     GuideAchievementNote[]
  tips      GuideTip[]
  revisions GuideRevision[]
  versions  GuideVersion[]
}

/// Full snapshot of a guide (fields, steps, notes) saved on every edit, for diff and restore.
model GuideVersion {
  id        String   @id @default(cuid())
  guideId   String
  /// Sequential per guide, starting at 1.
  version   Int
  snapshot  Json
  authorId  String?
  createdAt DateTime @default(now())
  guide     Guide    @relation(fields: [guideId], references: [id], onDelete: Cascade)
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([guideId, version])
}

model GuideStep {
  id                  String   @id @default(cuid())
  guideId             String
  order               Int
  title               String
  hours               String
  /// Plain text (always set; for bot steps it is the text of `blocks` without markup).
  body                String
  /// Rich body as ContentBlock[] (bot API). Null for steps written as plain text.
  blocks              Json?
  achievementApiNames String[]
  /// Stable key a bot gives the step (bot API `steps[].key`): updates match steps by it, so
  /// reordering, inserting or removing steps keeps readers' checkmarks on the right step.
  key                 String?
  guide               Guide    @relation(fields: [guideId], references: [id], onDelete: Cascade)

  progress GuideStepProgress[]

  @@unique([guideId, order])
  @@unique([guideId, key])
}

model GuideAchievementNote {
  id            String      @id @default(cuid())
  guideId       String
  achievementId String
  /// historia | chefes | coletaveis | desafio | dlc
  category      String
  spoiler       Boolean     @default(false)
  /// Plain text (always set; for bot notes it is the text of `tipBlocks` without markup).
  tip           String
  /// Rich tip as ContentBlock[] (bot API). Null for tips written as plain text.
  tipBlocks     Json?
  steps         String[]
  guide         Guide       @relation(fields: [guideId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([guideId, achievementId])
}

model GuideTip {
  id        String   @id @default(cuid())
  guideId   String
  authorId  String?
  body      String
  votes     Int      @default(0)
  createdAt DateTime @default(now())
  guide     Guide    @relation(fields: [guideId], references: [id], onDelete: Cascade)
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  voters GuideVote[]

  @@index([guideId])
}

model GuideVote {
  userId String
  tipId  String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tip    GuideTip @relation(fields: [tipId], references: [id], onDelete: Cascade)

  @@id([userId, tipId])
  @@index([tipId])
}

model GuideRevision {
  id        String   @id @default(cuid())
  guideId   String
  version   String
  summary   String
  authorId  String?
  createdAt DateTime @default(now())
  guide     Guide    @relation(fields: [guideId], references: [id], onDelete: Cascade)
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([guideId])
}

model GuideStepProgress {
  userId String
  stepId String
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  step   GuideStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@id([userId, stepId])
}

// ---------- Editorial ----------

model Author {
  id     String  @id @default(cuid())
  handle String  @unique
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  articles Article[]
}

model Article {
  id            String        @id @default(cuid())
  slug          String        @unique
  title         String
  subtitle      String?
  /// Short summary for cards and metadata.
  excerpt       String?
  /// Legacy Markdown body (Plan 1 pages). New code renders `blocks`.
  body          String
  /// ContentBlock[] (spec "Formato de conteúdo único em blocos").
  blocks        Json          @default("[]")
  /// draft | review | published | archived
  status        String        @default("draft")
  /// GAMES | GUIAS | COMUNIDADE | MERCADO | ENTRETENIMENTO | TECNOLOGIA
  category      String
  platforms     String[]
  imageLabel    String
  authorId      String
  /// Legacy single game (Plan 1 pages); new code uses `games` (ArticleGame).
  gameId        String?
  /// editorial | bot
  source        String?
  /// API key that created the article (source = bot).
  botKeyId      String?
  /// 0 = list, 1 = side highlight, 2 = main highlight
  featured      Int           @default(0)
  likes         Int           @default(0)
  comments      Int           @default(0)
  humanAuthored Boolean       @default(true)
  /// When an editor approved the article. For bot articles (source = bot) it marks the ones an
  /// editor reviewed in the admin; bots publishing with the `publish` scope leave it null. The
  /// public byline is "Equipe Tralked" either way (no robot badge).
  reviewedAt    DateTime?
  /// Publication time. For drafts it holds the creation time until the article is published.
  publishedAt   DateTime      @default(now())
  /// First time the article went live. Never cleared: once set, the slug (its public URL) is frozen.
  firstPublishedAt DateTime?
  /// Publish automatically at this time (status moves to published).
  scheduledAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  author        Author        @relation(fields: [authorId], references: [id])
  game          Game?         @relation(fields: [gameId], references: [id])
  botKey        ApiKey?       @relation(fields: [botKeyId], references: [id], onDelete: SetNull)
  games         ArticleGame[]

  @@index([publishedAt])
  @@index([status, publishedAt])
}

/// Games an article is about (n:n).
model ArticleGame {
  articleId String
  gameId    String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  game      Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([articleId, gameId])
  @@index([gameId])
}

/// Headline from an external RSS feed: only title, link, source and date are stored.
model ExternalNews {
  id          String   @id @default(cuid())
  gameId      String?
  title       String
  url         String   @unique
  /// Name of the publication (NewsFeed.name).
  source      String
  publishedAt DateTime
  fetchedAt   DateTime @default(now())
  /// Area of the feed it came from: GAMES | ENTRETENIMENTO | TECNOLOGIA (src/lib/news/areas.ts).
  area        String   @default("GAMES")
  game        Game?    @relation(fields: [gameId], references: [id], onDelete: SetNull)

  @@index([gameId, publishedAt])
  @@index([publishedAt])
  @@index([area, publishedAt])
}

/// RSS feed configured in the admin.
model NewsFeed {
  id     String  @id @default(cuid())
  name   String
  url    String  @unique
  active Boolean @default(true)
  /// GAMES | ENTRETENIMENTO | TECNOLOGIA: which headlines are kept and which tab shows them.
  area   String  @default("GAMES")
}

// ---------- Community ----------

/// Comment on an article, guide, photo or forum thread (polymorphic target, no FK).
model Comment {
  id         String    @id @default(cuid())
  authorId   String?
  /// article | guide | photo | thread
  targetType String
  targetId   String
  body       String
  /// visible | hidden | removed | deleted
  status     String    @default("visible")
  createdAt  DateTime  @default(now())
  editedAt   DateTime?
  author     User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId, createdAt])
  @@index([authorId, createdAt])
}

model Report {
  id           String    @id @default(cuid())
  reporterId   String?
  /// article | guide | photo | thread | comment | post | user
  targetType   String
  targetId     String
  reason       String
  /// open | resolved | dismissed
  status       String    @default("open")
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedById String?
  reporter     User?     @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  resolvedBy   User?     @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([targetType, targetId])
}

model ForumCategory {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String
  order       Int    @default(0)

  threads ForumThread[]
}

/// Forum topic: in a general category, or a game's own topic list (gameId), or both.
model ForumThread {
  id           String         @id @default(cuid())
  categoryId   String?
  gameId       String?
  authorId     String?
  title        String
  /// URL slug (not unique; routes use id + slug).
  slug         String
  /// open | locked | hidden | removed
  status       String         @default("open")
  pinned       Boolean        @default(false)
  /// Reply marked "Resolveu" by the thread author.
  solvedPostId String?        @unique
  createdAt    DateTime       @default(now())
  lastPostAt   DateTime       @default(now())
  category     ForumCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  game         Game?          @relation(fields: [gameId], references: [id], onDelete: SetNull)
  author       User?          @relation(fields: [authorId], references: [id], onDelete: SetNull)
  solvedPost   ForumPost?     @relation("SolvedPost", fields: [solvedPostId], references: [id], onDelete: SetNull)

  posts ForumPost[]

  @@index([categoryId, pinned, lastPostAt])
  @@index([gameId, lastPostAt])
}

model ForumPost {
  id        String       @id @default(cuid())
  threadId  String
  authorId  String?
  body      String
  createdAt DateTime     @default(now())
  editedAt  DateTime?
  /// visible | hidden | removed
  status    String       @default("visible")
  thread    ForumThread  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author    User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  solves    ForumThread? @relation("SolvedPost")

  @@index([threadId, createdAt])
  @@index([authorId, createdAt])
}

/// Community gallery photo. `url` null = example data (the UI draws generated art).
model Photo {
  id        String   @id @default(cuid())
  authorId  String?
  gameId    String?
  url       String?
  width     Int
  height    Int
  caption   String?
  /// visible | hidden | removed
  status    String   @default("visible")
  createdAt DateTime @default(now())
  likeCount Int      @default(0)
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  game      Game?    @relation(fields: [gameId], references: [id], onDelete: SetNull)

  likes PhotoLike[]

  @@index([status, createdAt])
  @@index([authorId, createdAt])
  @@index([gameId, createdAt])
}

model PhotoLike {
  userId    String
  photoId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  photo     Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@id([userId, photoId])
  @@index([photoId])
}

// ---------- Bot API ----------

/// Bot API key (`Bearer tk_live_…`). Only the SHA-256 `hash` is stored; the key is shown once.
model ApiKey {
  id          String    @id @default(cuid())
  name        String
  /// First characters of the key, shown in the admin to tell keys apart.
  prefix      String
  hash        String    @unique
  /// articles:write | guides:write | publish | media:write
  scopes      String[]
  createdById String?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  articles   Article[]
  guides     Guide[]
  ingestions IngestionLog[]
}

/// One bot POST. (keyId, idempotencyKey) is unique, so a repeated request returns the stored result.
model IngestionLog {
  id             String   @id @default(cuid())
  keyId          String
  idempotencyKey String
  /// article | guide
  kind           String
  /// created | updated | rejected
  status         String
  /// Article or Guide id (created | updated).
  resultId       String?
  /// Validation errors (rejected), by JSON Pointer path.
  error          Json?
  /// SHA-256 of method + path + canonical JSON body. Same key and hash replays `response`;
  /// same key with another hash is a 409.
  requestHash    String?
  /// The HTTP answer given to the request: { status, body }. Replayed on a repeat.
  response       Json?
  createdAt      DateTime @default(now())
  key            ApiKey   @relation(fields: [keyId], references: [id], onDelete: Cascade)

  @@unique([keyId, idempotencyKey])
  @@index([createdAt])
}

// ---------- Notifications ----------

model Notification {
  id        String    @id @default(cuid())
  userId    String
  /// level_up | skill_up | attribute_up | comment_reply | forum_reply | thread_solved |
  /// photo_like | content_published | report_resolved | system
  kind      String
  title     String
  body      String?
  /// Relative link inside the site.
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

// ---------- Family ----------

model Family {
  id        String   @id @default(cuid())
  name      String
  ownerId   String?
  createdAt DateTime @default(now())
  owner     User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  members FamilyMember[]
  invites FamilyInvite[]
}

model FamilyMember {
  familyId String
  userId   String   @unique
  role     String
  joinedAt DateTime @default(now())
  family   Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([familyId, userId])
}

model FamilyInvite {
  id        String    @id @default(cuid())
  familyId  String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  family    Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
}

model NewsletterSubscriber {
  id          String    @id @default(cuid())
  email       String    @unique
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())
}

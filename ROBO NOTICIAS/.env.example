# Copy to .env and fill in. .env is gitignored.
# Onde a IA roda: claude-code (padrão: o Claude Code deste PC, pela assinatura) ou api (créditos da API).
AI_BACKEND=claude-code
# Caminho do Claude Code quando o agendador não acha "claude" no PATH.
CLAUDE_BIN=
# O robô para quando o limite semanal da assinatura passa desta fração (o resto fica para o Lucas).
CLAUDE_WEEKLY_STOP=0.9
# Só com AI_BACKEND=api.
ANTHROPIC_API_KEY=
TRALKED_API_URL=https://tralked.com
TRALKED_API_KEY=
MODEL_WRITER=claude-opus-5-5
MODEL_FAST=claude-haiku-5-5
DAILY_BUDGET_USD=5
BACKFILL_BUDGET_USD=70
MAX_PER_DAY=15
NEWS_MAX_AGE_HOURS=12
SLOT_FIRST_HOUR=6
SLOT_LAST_HOUR=23
BACKFILL_DAYS=90
BACKFILL_TOTAL=750
# Optional: alert emails
RESEND_API_KEY=
ALERT_EMAIL=
DATA_DIR=./data
